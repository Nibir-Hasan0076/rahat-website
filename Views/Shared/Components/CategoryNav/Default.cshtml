@model List<StyleNest.Models.Category>

<a class="dropdown-item" asp-area="" asp-controller="Shop" asp-action="Index">All products</a>
@if (Model.Count > 0)
{
    <div class="dropdown-divider"></div>
    @foreach (var category in Model)
    {
        <a class="dropdown-item" asp-area="" asp-controller="Shop" asp-action="Index" asp-route-category="@category.Id">@category.Name</a>
    }
}
