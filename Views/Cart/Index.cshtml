@model List<StyleNest.Models.CartItem>
@{
    ViewData["Title"] = "Your bag";
    var subtotal = Model.Sum(i => i.LineTotal);
    var shipping = StoreSettings.ShippingFor(subtotal);
    var total = subtotal + shipping;
    var itemCount = Model.Sum(i => i.Quantity);
    var remainingForFreeShipping = StoreSettings.FreeShippingThreshold - subtotal;
}

<section class="page-hero">
    <div class="container">
        <div class="breadcrumb-custom">
            <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <span class="sep">/</span>
            <span>Your bag</span>
        </div>
        <span class="eyebrow">Step 1 of 3</span>
        <h1>Your bag</h1>
        <p>Review the pieces you've picked before moving to checkout.</p>
    </div>
</section>

<div class="container">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8.5h12l1 12H5l1-12Z"></path>
                    <path d="M9 8.5V6a3 3 0 0 1 6 0v2.5"></path>
                </svg>
            </div>
            <h2>Your bag is empty</h2>
            <p>Start with something you love — browse the collection and add a piece or two.</p>
            <a class="btn-ink" asp-area="" asp-controller="Shop" asp-action="Index">Start shopping</a>
        </div>
    }
    else
    {
        <div class="cart-layout" data-cart
             data-shipping-fee="@StoreSettings.ShippingFee.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-free-threshold="@StoreSettings.FreeShippingThreshold.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            <div>
                <div class="cart-list">
                    @foreach (var item in Model)
                    {
                        <div class="cart-row" data-unit-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <a asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">
                                <img class="cart-thumb" src="@(item.ImageUrl ?? "/images/placeholder-product.svg")" alt="@item.Name" />
                            </a>
                            <div class="cart-info">
                                <span class="product-cat">@item.CategoryName</span>
                                <h3><a asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">@item.Name</a></h3>
                                <span class="cart-unit">@StoreSettings.Money(item.Price) each</span>
                                <div class="cart-controls">
                                    <form method="post" asp-area="" asp-controller="Cart" asp-action="Update" class="d-inline-flex align-items-center gap-2">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <div class="qty-stepper small" data-qty>
                                            <button type="button" data-step="-1" aria-label="Decrease quantity">−</button>
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.Stock" aria-label="Quantity for @item.Name" />
                                            <button type="button" data-step="1" aria-label="Increase quantity">+</button>
                                        </div>
                                        <button type="submit" class="update-btn">Update</button>
                                    </form>
                                    <form method="post" asp-area="" asp-controller="Cart" asp-action="Remove">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="cart-remove">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                                <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13"></path>
                                            </svg>
                                            Remove
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="cart-line-total" data-line-total>@StoreSettings.Money(item.LineTotal)</div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <a class="link-underline" asp-area="" asp-controller="Shop" asp-action="Index">← Continue shopping</a>
                    <form method="post" asp-area="" asp-controller="Cart" asp-action="Clear" data-confirm="Remove all items from your bag?">
                        <button type="submit" class="cart-remove">Clear bag</button>
                    </form>
                </div>
            </div>

            <aside class="summary-card">
                <h2>Order summary</h2>
                <div class="summary-row">
                    <span>Subtotal (<span data-summary-count>@itemCount</span> <span data-summary-count-word>@(itemCount == 1 ? "item" : "items")</span>)</span>
                    <strong data-summary-subtotal>@StoreSettings.Money(subtotal)</strong>
                </div>
                <div class="summary-row">
                    <span>Delivery</span>
                    <strong data-summary-delivery>@(shipping == 0 ? "Free" : StoreSettings.Money(shipping))</strong>
                </div>

                <div class="free-ship-note @(shipping == 0 ? "unlocked" : "")" data-free-note>
                    @if (shipping == 0)
                    {
                        <text>You've unlocked free delivery on this order.</text>
                    }
                    else
                    {
                        <text>Add <strong>@StoreSettings.Money(remainingForFreeShipping)</strong> more to unlock free delivery.</text>
                    }
                </div>

                <div class="summary-total">
                    <span>Total</span>
                    <span class="price" data-summary-total>@StoreSettings.Money(total)</span>
                </div>

                <div class="cart-actions">
                    <a class="btn-ink" asp-area="" asp-controller="Checkout" asp-action="Index" data-checkout-link>
                        Proceed to checkout
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14M13 6l6 6-6 6"></path>
                        </svg>
                    </a>
                </div>
                <div class="secure-note">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="10" width="16" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                    </svg>
                    Secure checkout · Cash on delivery available
                </div>
            </aside>
        </div>
    }
</div>
