@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Admin";
    var initial = string.IsNullOrWhiteSpace(displayName) ? "A" : displayName.Trim()[0].ToString().ToUpper();
    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · StyleNest Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
<div class="admin-shell">
    <aside class="admin-sidebar">
        <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            Style<span>Nest</span>
            <small>Store manager</small>
        </a>

        <div class="admin-nav-label">Manage store</div>
        <nav class="admin-nav">
            <a class="@(controller == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="9" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="5" rx="1"></rect>
                    <rect x="14" y="12" width="7" height="9" rx="1"></rect>
                    <rect x="3" y="16" width="7" height="5" rx="1"></rect>
                </svg>
                Dashboard
            </a>
            <a class="@(controller == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8.5h12l1 12H5l1-12Z"></path><path d="M9 8.5V6a3 3 0 0 1 6 0v2.5"></path>
                </svg>
                Orders
            </a>
            <a class="@(controller == "Products" ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3 4 7v10l8 4 8-4V7l-8-4Z"></path><path d="m4 7 8 4 8-4M12 11v10"></path>
                </svg>
                Products
            </a>
            <a class="@(controller == "Categories" ? "active" : "")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect>
                </svg>
                Categories
            </a>
        </nav>

        <div class="admin-sidebar-footer">
            <div class="admin-user">
                <span class="avatar">@initial</span>
                <div class="admin-user-info">
                    <strong>@displayName</strong>
                    <span>Administrator</span>
                </div>
            </div>
            <div class="sidebar-links">
                <a class="sidebar-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 11 12 3l9 8"></path><path d="M5 10v10h14V10"></path>
                    </svg>
                    View storefront
                </a>
                <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Logout">
                    <button type="submit" class="sidebar-link">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5V3h4M16 17l5-5-5-5M21 12H9"></path>
                        </svg>
                        Sign out
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <main class="admin-main">
        @if (successMessage is not null)
        {
            <div class="admin-flash success">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 12 5 5L20 7"></path>
                </svg>
                @successMessage
            </div>
        }
        @if (errorMessage is not null)
        {
            <div class="admin-flash error">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16.5v.5"></path>
                </svg>
                @errorMessage
            </div>
        }

        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
