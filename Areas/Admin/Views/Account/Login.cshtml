@model StyleNest.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Admin sign in";
    Layout = "_AuthLayout";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-card">
    <div class="auth-art">
        <div>
            <div class="auth-brand">Style<span>Nest</span></div>
            <h2>Run your store, the calm way.</h2>
            <p>Manage categories, products, stock and incoming orders from one tidy dashboard.</p>
        </div>
        <div class="art-foot">Store manager · 2026</div>
    </div>

    <div class="auth-form">
        <span class="eyebrow" style="font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:#857e72;font-weight:700;">Welcome back</span>
        <h1>Admin sign in</h1>
        <p class="sub">Sign in to manage the StyleNest store.</p>

        <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="mb-3">
                <label class="admin-label" asp-for="Username">Username</label>
                <input class="form-control" asp-for="Username" autocomplete="username" placeholder="admin" autofocus />
                <span asp-validation-for="Username"></span>
            </div>

            <div class="mb-2">
                <label class="admin-label" asp-for="Password">Password</label>
                <input class="form-control" asp-for="Password" autocomplete="current-password" placeholder="Your password" />
                <span asp-validation-for="Password"></span>
            </div>

            <label class="form-check-custom mt-2">
                <input asp-for="RememberMe" />
                <span>
                    <strong>Keep me signed in</strong>
                    <span>Stay signed in on this device for 8 hours.</span>
                </span>
            </label>

            <div class="form-actions">
                <button type="submit" class="btn-admin primary">
                    Sign in
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M13 6l6 6-6 6"></path>
                    </svg>
                </button>
            </div>
        </form>

        <div class="credential-hint">
            Demo credentials — username <code>admin</code> · password <code>Admin@@123</code>
        </div>

        <div class="auth-back">
            <a asp-area="" asp-controller="Home" asp-action="Index">← Back to store</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
