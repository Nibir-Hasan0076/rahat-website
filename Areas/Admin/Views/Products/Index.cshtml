@model List<StyleNest.Models.Product>
@{
    ViewData["Title"] = "Products";
    var categories = ViewData["Categories"] as List<StyleNest.Models.Category> ?? new();
    var selectedCategory = ViewData["CategoryId"] as int?;
    var query = ViewData["Query"] as string;
}

<div class="admin-topbar">
    <div>
        <div class="admin-crumb">Catalogue</div>
        <h1>Products</h1>
        <p>Add pieces to your collections and keep stock up to date.</p>
    </div>
    <div class="admin-topbar-actions">
        <a class="btn-admin primary" asp-area="Admin" asp-controller="Products" asp-action="Create">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <path d="M12 5v14M5 12h14"></path>
            </svg>
            Add product
        </a>
    </div>
</div>

<div class="panel">
    <form method="get" asp-area="Admin" asp-controller="Products" asp-action="Index" class="filter-bar">
        <input class="form-control" type="search" name="q" value="@query" placeholder="Search products by name…" />
        <select class="form-select" name="category">
            <option value="">All categories</option>
            @foreach (var category in categories)
            {
                if (selectedCategory == category.Id)
                {
                    <option value="@category.Id" selected>@category.Name</option>
                }
                else
                {
                    <option value="@category.Id">@category.Name</option>
                }
            }
        </select>
        <button type="submit" class="btn-admin light sm">Filter</button>
        @if (!string.IsNullOrWhiteSpace(query) || selectedCategory.HasValue)
        {
            <a class="btn-admin light sm" asp-area="Admin" asp-controller="Products" asp-action="Index">Clear</a>
        }
    </form>

    @if (Model.Count == 0)
    {
        <div class="empty-admin">
            <strong>No products found</strong>
            @if (!string.IsNullOrWhiteSpace(query) || selectedCategory.HasValue)
            {
                <text>Try a different search or category filter.</text>
            }
            else
            {
                <text>Add your first product so it appears in the storefront.</text>
            }
            <div class="mt-3">
                <a class="btn-admin primary" asp-area="Admin" asp-controller="Products" asp-action="Create">Add product</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table-clean">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <div class="cell-product">
                                    <img class="thumb-sm" src="@(product.ImageUrl ?? "/images/placeholder-product.svg")" alt="@product.Name" />
                                    <div>
                                        <div class="cell-title">@product.Name</div>
                                        <div class="cell-sub">@product.Category?.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td class="num">@StoreSettings.Money(product.Price)</td>
                            <td>
                                <span class="badge-soft @(product.Stock == 0 ? "red" : product.Stock <= 5 ? "amber" : "green")">
                                    @(product.Stock == 0 ? "Out of stock" : $"{product.Stock} in stock")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <span class="badge-soft @(product.IsActive ? "green" : "gray")">@(product.IsActive ? "Live" : "Hidden")</span>
                                    @if (product.IsFeatured)
                                    {
                                        <span class="badge-soft amber">Featured</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <form method="post" asp-area="Admin" asp-controller="Products" asp-action="ToggleActive" asp-route-id="@product.Id">
                                        <button type="submit" class="icon-action" title="@(product.IsActive ? "Hide from store" : "Show in store")">
                                            @if (product.IsActive)
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
                                                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path><circle cx="12" cy="12" r="2.6"></circle>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
                                                    <path d="M3 3l18 18M10.6 6.2A10.8 10.8 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-3.2 3.7M6.2 7.3A17.4 17.4 0 0 0 2 12s3.5 6 10 6c1.2 0 2.3-.2 3.3-.6"></path>
                                                </svg>
                                            }
                                        </button>
                                    </form>
                                    <a class="icon-action" title="Edit product" asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M4 20h4L20 8l-4-4L4 16v4Z"></path><path d="m14 6 4 4"></path>
                                        </svg>
                                    </a>
                                    <form method="post" asp-area="Admin" asp-controller="Products" asp-action="Delete" asp-route-id="@product.Id"
                                          data-confirm="Delete &quot;@product.Name&quot;? This cannot be undone.">
                                        <button type="submit" class="icon-action danger" title="Delete product">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
                                                <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
